{
  "expo": {
    "name": "Tastoria",
    "slug": "tastoria",
    "version": "0.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tastoria",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFF9ED",
    "android": {
      "package": "net.ctslab.tastoria",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#FFF9ED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Tastoria",
      "lang": "vi",
      "themeColor": "#F3512C",
      "backgroundColor": "#FFF9ED"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tastoria dùng ảnh bạn chọn để nhận ra nguyên liệu trong tủ lạnh.",
          "cameraPermission": "Tastoria dùng máy ảnh để chụp tủ lạnh hoặc đồ vừa mua."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F0E2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#1A1612",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "./plugins/with-android-release"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
