# Copy to deploy/.env (chmod 600, never commit). scripts/deploy.sh --init-env writes one with fresh secrets.
# Every TASTORIA_* variable is read by the backend (backend/README.md, "Environment variables").

# PostgreSQL password of the `tastoria` role (also used in TASTORIA_DATABASE_URL by docker-compose.yml)
POSTGRES_PASSWORD=change-me

# JWT HS256 keys by kid (JSON). Rotate: add a new kid, switch ACTIVE_KID, drop the old one after 15 min.
TASTORIA_JWT_KEYS={"prod-1":"change-me-64-hex-chars"}
TASTORIA_JWT_ACTIVE_KID=prod-1

# AES-256-GCM keys for profiles.*_enc (base64 of 32 bytes). BACK UP SEPARATELY from the database (ADR 0005):
# losing it loses every user's body metrics. Keep old key ids listed while rows still use them.
TASTORIA_HEALTH_ENC_KEYS={"prod-1":"base64-of-32-bytes"}
TASTORIA_HEALTH_ENC_ACTIVE_KEY_ID=prod-1

# HMAC key for dsr_requests.subject_ref
TASTORIA_DSR_HMAC_KEY=change-me

# Public address (the app is served at the domain root)
TASTORIA_RESET_URL_BASE=https://safework.ctslab.net/dat-lai-mat-khau

# Mail: `log` = do not send, only log the subject (no SMTP account configured yet).
# To send real mail set MAILER=smtp and fill SMTP_* (STARTTLS on port 587 for most providers).
TASTORIA_MAILER=log
#TASTORIA_SMTP_HOST=smtp.example.com
#TASTORIA_SMTP_PORT=587
#TASTORIA_SMTP_USER=
#TASTORIA_SMTP_PASSWORD=
#TASTORIA_SMTP_STARTTLS=true
TASTORIA_MAIL_FROM=Tastoria <no-reply@safework.ctslab.net>

TASTORIA_LOG_LEVEL=INFO
TASTORIA_MIN_APP_VERSION=0.0.0
# uvicorn worker processes of the api container
TASTORIA_API_WORKERS=2

# Backups (scripts/backup.sh): rclone remote:path; empty = keep local copies only
BACKUP_RCLONE_DEST=
BACKUP_KEEP_DAYS=14
