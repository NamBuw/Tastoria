{
  "$schema": "https://github.com/NamBuw/appnwebsite-skill/schemas/tokens-dtcg.schema.json",
  "$description": "Tastoria W3C DTCG 3-tier design tokens (editorial-v10 Light — Crisp White / Warm Sand, Charcoal Ink, Terracotta Accent, Newsreader + Manrope).",
  "primitive": {
    "color": {
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "sand-50": { "$value": "#F7F5F2", "$type": "color" },
      "sand-100": { "$value": "#FAF7F2", "$type": "color" },
      "stone-200": { "$value": "#E8E3DC", "$type": "color" },
      "stone-400": { "$value": "#A8A29E", "$type": "color" },
      "ink-600": { "$value": "#645D56", "$type": "color" },
      "ink-900": { "$value": "#1C1917", "$type": "color" },
      "ivory-50": { "$value": "#F7F3EC", "$type": "color" },
      "oat-300": { "$value": "#D6CEC4", "$type": "color" },
      "terracotta-50": { "$value": "#FDF1EC", "$type": "color" },
      "terracotta-600": { "$value": "#B84225", "$type": "color" },
      "terracotta-700": { "$value": "#9E381E", "$type": "color" },
      "terracotta-800": { "$value": "#7C2D12", "$type": "color" },
      "herb-50": { "$value": "#EDF5F0", "$type": "color" },
      "herb-700": { "$value": "#2E6B4F", "$type": "color" },
      "info-50": { "$value": "#F1F4F9", "$type": "color" },
      "info-700": { "$value": "#3B5998", "$type": "color" },
      "warn-50": { "$value": "#FEF6E7", "$type": "color" },
      "warn-700": { "$value": "#9A5B13", "$type": "color" },
      "danger-50": { "$value": "#FEF3F2", "$type": "color" },
      "danger-700": { "$value": "#B42318", "$type": "color" }
    },
    "space": {
      "1": { "$value": "4px", "$type": "dimension" },
      "2": { "$value": "8px", "$type": "dimension" },
      "3": { "$value": "12px", "$type": "dimension" },
      "4": { "$value": "16px", "$type": "dimension" },
      "5": { "$value": "24px", "$type": "dimension" },
      "6": { "$value": "32px", "$type": "dimension" },
      "7": { "$value": "48px", "$type": "dimension" },
      "8": { "$value": "72px", "$type": "dimension" }
    },
    "radius": {
      "sm": { "$value": "8px", "$type": "dimension" },
      "md": { "$value": "12px", "$type": "dimension" },
      "lg": { "$value": "16px", "$type": "dimension" },
      "pill": { "$value": "9999px", "$type": "dimension" }
    },
    "typography": {
      "display": { "$value": "Newsreader", "$type": "fontFamily" },
      "body": { "$value": "Manrope", "$type": "fontFamily" },
      "mono": { "$value": "Geist Mono", "$type": "fontFamily" }
    }
  },
  "semantic": {
    "surface": {
      "canvas": { "$value": "{primitive.color.white}", "$type": "color" },
      "card": { "$value": "{primitive.color.white}", "$type": "color" },
      "elevated": { "$value": "{primitive.color.sand-50}", "$type": "color" },
      "soft-landing": { "$value": "{primitive.color.sand-100}", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "{primitive.color.ink-900}", "$type": "color" },
      "muted": { "$value": "{primitive.color.ink-600}", "$type": "color" },
      "brand": { "$value": "{primitive.color.terracotta-600}", "$type": "color" },
      "brand-strong": { "$value": "{primitive.color.terracotta-700}", "$type": "color" },
      "fresh": { "$value": "{primitive.color.herb-700}", "$type": "color" }
    },
    "editorial": {
      "panel": { "$value": "{primitive.color.ink-900}", "$type": "color" },
      "on-panel": { "$value": "{primitive.color.ivory-50}", "$type": "color" },
      "on-panel-muted": { "$value": "{primitive.color.oat-300}", "$type": "color" }
    },
    "brand": {
      "primary": { "$value": "{primitive.color.terracotta-600}", "$type": "color" },
      "primary-hover": { "$value": "{primitive.color.terracotta-700}", "$type": "color" },
      "on-primary": { "$value": "{primitive.color.white}", "$type": "color" },
      "tint": { "$value": "{primitive.color.terracotta-50}", "$type": "color" }
    },
    "border": {
      "subtle": { "$value": "{primitive.color.stone-200}", "$type": "color" },
      "strong": { "$value": "{primitive.color.stone-400}", "$type": "color" }
    },
    "status": {
      "fresh-ink": { "$value": "{primitive.color.herb-700}", "$type": "color" },
      "fresh-soft": { "$value": "{primitive.color.herb-50}", "$type": "color" },
      "info-ink": { "$value": "{primitive.color.info-700}", "$type": "color" },
      "info-soft": { "$value": "{primitive.color.info-50}", "$type": "color" },
      "warn-ink": { "$value": "{primitive.color.warn-700}", "$type": "color" },
      "warn-soft": { "$value": "{primitive.color.warn-50}", "$type": "color" },
      "danger-ink": { "$value": "{primitive.color.danger-700}", "$type": "color" },
      "danger-soft": { "$value": "{primitive.color.danger-50}", "$type": "color" }
    }
  },
  "component": {
    "button": {
      "primary-fill": { "$value": "{semantic.brand.primary}", "$type": "color" },
      "primary-label": { "$value": "{semantic.brand.on-primary}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.pill}", "$type": "dimension" },
      "padding-x": { "$value": "{primitive.space.5}", "$type": "dimension" },
      "padding-y": { "$value": "{primitive.space.3}", "$type": "dimension" }
    },
    "card": {
      "fill": { "$value": "{semantic.surface.card}", "$type": "color" },
      "stroke": { "$value": "{semantic.border.subtle}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.lg}", "$type": "dimension" },
      "padding": { "$value": "{primitive.space.5}", "$type": "dimension" }
    },
    "font": {
      "heading": { "$value": "{primitive.typography.display}", "$type": "fontFamily" },
      "body": { "$value": "{primitive.typography.body}", "$type": "fontFamily" },
      "mono": { "$value": "{primitive.typography.mono}", "$type": "fontFamily" }
    }
  }
}
