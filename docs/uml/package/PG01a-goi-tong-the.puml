@startuml
title PG01a — Gói: bố cục mã nguồn tổng thể
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

skinparam componentStyle rectangle

package "backend/src/tastoria" as Be {
  file "core" as Core <<M01>>
  file "modules" as Mods <<M02–M15>>
  file "jobs" as Jobs <<M16>>
  file "cli" as Cli
}
package "backend/migrations" as Mig
package "app (Expo, TypeScript)" as App
package "landing (HTML/CSS)" as Land

Mods ..> Core
Jobs ..> Mods
Cli ..> Mods
Mig ..> Core
@enduml
