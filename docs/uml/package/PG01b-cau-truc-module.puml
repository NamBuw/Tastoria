@startuml
title PG01b — Gói: cấu trúc một module (ví dụ meal)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

skinparam componentStyle rectangle

package "tastoria.modules.meal" as M <<M11>> {
  file "router.py" as Router
  file "schemas.py" as Schemas
  file "service.py" as Service <<public>>
  file "models.py" as Models
  file "composer.py" as Composer
  file "schedule.py" as Schedule
  file "ranker.py" as Ranker
}

Router ..> Service
Router ..> Schemas
Service ..> Models
Service ..> Composer
Service ..> Schedule
Service ..> Ranker
@enduml
