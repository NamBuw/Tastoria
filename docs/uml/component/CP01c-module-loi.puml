@startuml
title CP01c — Thành phần: module lõi, định danh và danh mục
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

skinparam componentStyle rectangle

component "M01 core" as core <<module>>
component "M02 identity" as identity <<module>>
component "M03 privacy" as privacy <<module>>
component "M04 catalog" as catalog <<module>>
component "M05 profile" as profile <<module>>

identity ..> core
privacy ..> core
privacy ..> identity
catalog ..> core
profile ..> core
profile ..> identity
profile ..> privacy
profile ..> catalog
@enduml
