@startuml
title UCD04 — Gói PK4 Kho & quét
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle stick
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

actor "Người dùng\n(A02)" as A02
rectangle "Tastoria" {
  usecase "UC12\nQuét nguyên liệu" as UC12
  usecase "UC13\nXác nhận và sửa kết quả quét" as UC13
  usecase "UC14\nQuản lý kho" as UC14
}

A02 -- UC12
A02 -- UC14
UC12 ..> UC13 : <<include>>
@enduml
