@startuml
title UCD03 — Gói PK3 Hồ sơ & mục tiêu
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle stick
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

actor "Người dùng\n(A02)" as A02
rectangle "Tastoria" {
  usecase "UC09\nThiết lập hồ sơ 60 giây" as UC09
  usecase "UC10\nCập nhật hồ sơ, dị ứng, chế độ ăn, cài đặt bếp" as UC10
  usecase "UC11\nĐặt mục tiêu năng lượng" as UC11
}

A02 -- UC09
A02 -- UC10
A02 -- UC11
@enduml
