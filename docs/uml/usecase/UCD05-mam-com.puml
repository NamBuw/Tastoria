@startuml
title UCD05 — Gói PK5 Mâm cơm
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle stick
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

actor "Người dùng\n(A02)" as A02
rectangle "Tastoria" {
  usecase "UC15\nNhận mâm cơm hôm nay" as UC15
  usecase "UC16\nĐổi một món" as UC16
  usecase "UC17\nXem và chọn thay thế nguyên liệu thiếu" as UC17
  usecase "UC18\nQuản lý danh sách đi chợ" as UC18
}

A02 -- UC15
UC16 ..> UC15 : <<extend>>
UC17 ..> UC15 : <<extend>>
UC18 ..> UC17 : <<extend>>
UC18 ..> UC15 : <<extend>>\n[không có mâm khả thi (BR-TRAY-06)]
@enduml
