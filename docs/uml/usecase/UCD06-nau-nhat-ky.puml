@startuml
title UCD06 — Gói PK6 Nấu & nhật ký
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle stick
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

actor "Người dùng\n(A02)" as A02
rectangle "Tastoria" {
  usecase "UC19\nNấu cả mâm" as UC19
  usecase "UC20\nHoàn tất bữa nấu" as UC20
  usecase "UC21\nHoàn tác trừ kho" as UC21
  usecase "UC22\nXem nhật ký tuần" as UC22
}

A02 -- UC19
A02 -- UC20
A02 -- UC22
UC21 ..> UC20 : <<extend>>
@enduml
