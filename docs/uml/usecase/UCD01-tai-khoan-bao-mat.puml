@startuml
title UCD01 — Gói PK1 Tài khoản & bảo mật
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle stick
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

actor "Khách\n(A01)" as A01
actor "Người dùng\n(A02)" as A02
rectangle "Tastoria" {
  usecase "UC01\nĐăng ký tài khoản" as UC01
  usecase "UC02\nĐăng nhập" as UC02
  usecase "UC03\nĐăng xuất" as UC03
  usecase "UC04\nĐặt lại mật khẩu" as UC04
}
actor "Dịch vụ email\n(A09)" as A09 <<system>>

A02 -|> A01
A01 -- UC01
A01 -- UC02
A02 -- UC03
A01 -- UC04
UC04 -- A09
@enduml
