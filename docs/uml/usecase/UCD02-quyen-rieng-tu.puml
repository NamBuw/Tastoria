@startuml
title UCD02 — Gói PK2 Quyền riêng tư
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle stick
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

actor "Người dùng\n(A02)" as A02
rectangle "Tastoria" {
  usecase "UC05\nQuản lý đồng ý theo mục đích" as UC05
  usecase "UC06\nTải về dữ liệu cá nhân" as UC06
  usecase "UC07\nXoá tài khoản và toàn bộ dữ liệu" as UC07
  usecase "UC08\nYêu cầu sửa, hạn chế hoặc phản đối xử lý" as UC08
}
actor "Quản trị viên\n(A04)" as A04

A02 -- UC05
A02 -- UC06
A02 -- UC07
A02 -- UC08
UC08 -- A04
@enduml
