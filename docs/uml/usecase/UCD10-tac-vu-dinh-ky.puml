@startuml
title UCD10 — Gói PK10 Tác vụ định kỳ
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle stick
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

actor "Bộ lập lịch\n(A08)" as A08
rectangle "Tastoria" {
  usecase "UC32\nXoá ảnh quét quá hạn" as UC32
  usecase "UC33\nSao lưu cơ sở dữ liệu" as UC33
  usecase "UC34\nDọn job quét kẹt, token và khoá lũy đẳng hết hạn" as UC34
}

A08 -- UC32
A08 -- UC33
A08 -- UC34
@enduml
