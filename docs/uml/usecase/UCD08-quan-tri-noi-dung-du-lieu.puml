@startuml
title UCD08 — Gói PK8 Quản trị nội dung & dữ liệu
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle stick
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

actor "Người biên soạn công thức\n(A05)" as A05
actor "Quản trị viên\n(A04)" as A04
rectangle "Tastoria" {
  usecase "UC25\nNhập và kiểm tra kho công thức, nguyên liệu" as UC25
  usecase "UC26\nQuản lý cặp thay thế nguyên liệu" as UC26
  usecase "UC27\nXử lý yêu cầu dữ liệu và xem nhật ký kiểm toán" as UC27
}

A05 -- UC25
A05 -- UC26
A04 -- UC27
@enduml
