@startuml
title SD03b — Nhận mâm cơm (UC15)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 30

actor "Người dùng" as U
boundary "App" as APP
control "API (meal)" as API
entity "CSDL" as DB

U -> APP : bấm Nhận mâm
APP -> API : nhận mâm
API -> DB : «proposed» → «accepted» (đúng chủ)
alt cập nhật được
  API --> APP : 200 mâm đã nhận
else không thấy hoặc sai trạng thái
  API --> APP : 409 sai trạng thái
end
APP --> U : hiện nút «Nấu cả mâm»
@enduml
