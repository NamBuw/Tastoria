@startuml
title SD02a — Sửa chip nguyên liệu (UC13)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 30

actor "Người dùng" as U
boundary "App" as APP
control "API (scan)" as API
entity "CSDL" as DB

U -> APP : mở kết quả quét
APP -> API : lấy chip và ảnh
API --> APP : chip, ảnh
loop còn chip cần sửa
  U -> APP : đổi nhãn, số lượng hoặc xoá chip
  APP -> API : gửi sửa chip
  API -> DB : cập nhật chip (chưa ghi kho)
  API --> APP : chip đã sửa
end
@enduml
