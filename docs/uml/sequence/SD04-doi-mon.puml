@startuml
title SD04 — Đổi một món trong mâm (UC16)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 30

actor "Người dùng" as U
boundary "App" as APP
control "API (meal)" as API
control "Hồ sơ & kho" as PRO
entity "CSDL" as DB

U -> APP : chọn món cần đổi và lý do
APP -> API : đổi món (khóa lũy đẳng)
API -> DB : khoá mâm, kiểm tra món đang dùng
API -> PRO : lấy ràng buộc và lô khả dụng
PRO --> API : ràng buộc, lô
alt có món thay
  API -> DB : món cũ «swapped_out», thêm món mới
  API --> APP : mâm đã cập nhật
else không còn ứng viên
  API --> APP : 422 không còn món thay
end
APP --> U : hiện mâm
@enduml
