@startuml
title SD01b — Worker nhận diện nguyên liệu (UC12)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 30

entity "Hàng đợi (Valkey)" as Q
control "Worker (scan)" as WK
entity "Kho tệp" as FS
entity "CSDL" as DB

Q -> WK : giao job nhận diện
WK -> DB : lần quét → «processing»
WK -> FS : đọc ảnh quét
FS --> WK : ảnh
WK -> WK : nhận diện, gộp số đếm theo ngăn
alt nhận diện thành công
  WK -> DB : ghi chip và khung phát hiện; → «done»
  WK -> Q : thông báo «done»
else lỗi, còn lượt thử
  WK -> Q : xếp lại job
else lỗi lần thứ 3
  WK -> DB : lần quét → «failed»
  WK -> Q : thông báo «failed»
end
@enduml
