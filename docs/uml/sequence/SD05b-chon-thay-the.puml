@startuml
title SD05b — Chọn một thay thế (UC17)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 30

actor "Người dùng" as U
boundary "App" as APP
control "API (meal)" as API
control "substitute" as SUB
entity "CSDL" as DB

U -> APP : chọn một gợi ý
APP -> API : ghi thay thế cho món
API -> SUB : kiểm tra cặp được phép
SUB --> API : đạt / vi phạm
alt vi phạm dị ứng, chế độ ăn hoặc khác nhóm
  API --> APP : 422 không hợp lệ
else hợp lệ
  API -> DB : ghi thay thế đã chọn
  API --> APP : món đã cập nhật
end
APP --> U : hiện món
@enduml
