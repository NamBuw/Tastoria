@startuml
title SD07a — Rút đồng ý theo mục đích (UC05)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 30

actor "Người dùng" as U
boundary "App" as APP
control "API (privacy)" as API
entity "CSDL" as DB
entity "Hàng đợi (Valkey)" as Q

U -> APP : tắt một mục đích
APP -> API : rút đồng ý
API -> DB : đọc đồng ý hiện hành
alt mục đích bắt buộc hoặc chưa đồng ý
  API --> APP : không đổi
else đang đồng ý
  API -> DB : ghi sự kiện rút, vô hiệu token, tạo yêu cầu
  API -> Q : đưa job xoá dữ liệu mục đích
  API --> APP : 202 đã ghi nhận
end
APP --> U : báo đã rút; làm mới phiên
@enduml
