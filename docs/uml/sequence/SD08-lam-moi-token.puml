@startuml
title SD08 — Làm mới phiên bằng refresh token xoay vòng (UC02)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 30

boundary "App" as APP
control "API (identity)" as API
entity "CSDL" as DB

APP -> API : làm mới phiên (refresh token)
API -> DB : khoá và tra token theo băm
alt token đã thu hồi (bị dùng lại)
  API -> DB : thu hồi cả họ token
  API --> APP : 401 đăng nhập lại
else hết hạn hoặc tài khoản chờ xoá
  API --> APP : 401
else hợp lệ
  API -> DB : thu hồi token cũ, cấp token mới cùng họ
  API --> APP : access token và refresh token mới
end
@enduml
