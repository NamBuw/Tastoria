@startuml
title SD05c — Thêm nguyên liệu thiếu vào danh sách đi chợ (UC18)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 30

actor "Người dùng" as U
boundary "App" as APP
control "API (substitute)" as API
entity "CSDL" as DB

U -> APP : chọn «Mua thêm»
APP -> API : thêm mục đi chợ
API -> DB : ghi mục đi chợ «open»
API --> APP : mục đã thêm
APP --> U : hiện danh sách đi chợ
@enduml
