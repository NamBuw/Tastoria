@startuml
title SD06c — Hoàn tác trừ kho (UC21)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 30

actor "Người dùng" as U
boundary "App" as APP
control "API (cooking)" as API
control "pantry" as PAN
entity "CSDL" as DB

U -> APP : bấm «Hoàn tác»
APP -> API : hoàn tác phiên
API -> DB : khoá phiên, đọc thời điểm hoàn tất
alt «completed» và còn trong 10 phút
  API -> PAN : đảo giao dịch trừ kho của phiên
  PAN -> DB : ghi giao dịch đảo; lô có lại lượng
  API -> DB : phiên «reverted», mâm về «accepted»
  API --> APP : 200 đã hoàn tác
else đã quá 10 phút
  API --> APP : 409 hết hạn hoàn tác
end
APP --> U : hiện kho
@enduml
