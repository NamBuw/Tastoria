@startuml
title SD10c — Triển khai phiên bản mô hình (UC30)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 30

actor "Người vận hành mô hình" as OP
boundary "CLI tastoria" as CLI
control "mlops" as ML
entity "CSDL" as DB
control "api + worker" as SVC

OP -> CLI : mlops deploy <tên> <phiên bản>
CLI -> ML : triển khai
ML -> DB : đọc trạng thái phiên bản
alt chưa «validated»
  ML --> CLI : từ chối
else «validated»
  ML -> DB : đổi con trỏ triển khai, giữ bản trước
  ML -> SVC : khởi động lại api và worker
  SVC -> DB : đọc con trỏ, nạp mô hình, kiểm sha256
  ML --> CLI : đã triển khai
end
CLI --> OP : kết quả
@enduml
