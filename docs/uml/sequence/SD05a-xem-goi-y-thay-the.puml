@startuml
title SD05a — Xem gợi ý thay thế nguyên liệu thiếu (UC17)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

autonumber
hide footbox
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 30

actor "Người dùng" as U
boundary "App" as APP
control "API (meal)" as API
control "substitute" as SUB
entity "CSDL" as DB

U -> APP : bấm «Thiếu gì?»
APP -> API : lấy thay thế cho món
API -> SUB : gợi ý cho nguyên liệu thiếu
loop mỗi nguyên liệu thiếu
  SUB -> DB : tra cặp thay thế, lọc dị ứng, chế độ ăn
  DB --> SUB : ứng viên
end
SUB --> API : tối đa 3 gợi ý
API --> APP : gợi ý
APP --> U : hiện gợi ý
@enduml
