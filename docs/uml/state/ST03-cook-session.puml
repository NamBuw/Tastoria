@startuml
title ST03 — Trạng thái phiên nấu (CookSession)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide empty description
skinparam StateBackgroundColor White

state "in_progress" as in_progress : entry / lập lịch nấu
state "completed" as completed : entry / trừ kho
state "reverted" as reverted
state "abandoned" as abandoned
state "sealed" as sealed

[*] --> in_progress : mở phiên
in_progress --> completed : nấu xong
completed --> reverted : hoàn tác [≤ 10 phút]
completed --> sealed : sau 10 phút
in_progress --> abandoned : bỏ phiên
@enduml
