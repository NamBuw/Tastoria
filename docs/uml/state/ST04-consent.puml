@startuml
title ST04 — Trạng thái đồng ý theo mục đích (Consent)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide empty description
skinparam StateBackgroundColor White

state "none" as none
state "granted" as granted
state "withdrawn" as withdrawn : entry / xoá dữ liệu ≤ 24 giờ
state "superseded" as superseded : entry / hỏi lại đồng ý

[*] --> none : đăng ký tài khoản
none --> granted : đồng ý
granted --> withdrawn : rút
withdrawn --> granted : đồng ý lại
granted --> superseded : có điều khoản mới
superseded --> granted : đồng ý bản mới
superseded --> withdrawn : rút
@enduml
