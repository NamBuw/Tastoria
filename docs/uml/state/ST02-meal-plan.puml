@startuml
title ST02 — Trạng thái mâm cơm (MealPlan)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide empty description
skinparam StateBackgroundColor White

state "proposed" as proposed
state "accepted" as accepted
state "cooked" as cooked
state "abandoned" as abandoned
state "expired" as expired

[*] --> proposed : tạo mâm
proposed --> accepted : nhận mâm
proposed --> expired : tạo mâm mới / hết giờ bữa
accepted --> cooked : phiên nấu hoàn tất
cooked --> accepted : hoàn tác [≤ 10 phút]
accepted --> abandoned : tạo mâm mới / hết giờ bữa
@enduml
