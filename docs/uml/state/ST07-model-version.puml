@startuml
title ST07 — Trạng thái phiên bản mô hình (ModelVersion)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide empty description
skinparam StateBackgroundColor White

state "candidate" as candidate
state cGate <<choice>>
state "validated" as validated
state "rejected" as rejected
state "active" as active : entry / nạp ở api, worker
state "retired" as retired

[*] --> candidate : đăng ký
candidate --> cGate : kiểm định
cGate --> validated : [đạt]
cGate --> rejected : [không đạt]
validated --> active : triển khai / quay lui
active --> validated : bị thay / quay lui
validated --> retired : rời vị trí bản trước
@enduml
