@startuml
title ST06 — Trạng thái tài khoản (Account)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide empty description
skinparam StateBackgroundColor White

state "active" as active
state "locked" as locked : entry / khoá 15 phút
state "deletion_requested" as deletion_requested : entry / thu hồi mọi phiên
state "deleted" as deleted

[*] --> active : đăng ký
active --> locked : sai mật khẩu lần 5
locked --> active : sau 15 phút
active --> deletion_requested : yêu cầu xoá
locked --> deletion_requested : yêu cầu xoá
deletion_requested --> deleted : job xoá xong [≤ 24 giờ]
deleted --> [*]
@enduml
