@startuml
title ST08 — Trạng thái yêu cầu dữ liệu (DsrRequest)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide empty description
skinparam StateBackgroundColor White

state "received" as received
state "in_progress" as in_progress
state "completed" as completed
state "rejected" as rejected

[*] --> received : gửi yêu cầu
received --> in_progress : worker nhận job
in_progress --> completed : job xong / nhân sự xử lý
in_progress --> rejected : nhân sự từ chối
received --> completed : nhân sự chấp nhận
received --> rejected : nhân sự từ chối
@enduml
