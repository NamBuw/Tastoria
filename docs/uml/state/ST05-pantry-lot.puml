@startuml
title ST05 — Trạng thái lô kho (PantryLot)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide empty description
skinparam StateBackgroundColor White

state "in_stock" as in_stock
state "not_seen" as not_seen : entry / hỏi lô còn không
state "used_up" as used_up
state "discarded" as discarded

[*] --> in_stock : xác nhận quét / thêm tay
in_stock --> not_seen : quét toàn tủ không thấy
not_seen --> in_stock : xác nhận còn / thấy lại
not_seen --> discarded : bỏ
in_stock --> discarded : bỏ
in_stock --> used_up : hết lượng
used_up --> in_stock : hoàn tác nấu
@enduml
