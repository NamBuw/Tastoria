@startuml
title ST01 — Trạng thái lần quét (Scan)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide empty description
skinparam StateBackgroundColor White

state "queued" as queued
state "processing" as processing
state cErr <<choice>>
state "done" as done
state "failed" as failed
state "expired" as expired
state "confirmed" as confirmed
state "discarded" as discarded

[*] --> queued : tạo lần quét
queued --> processing : worker nhận job
processing --> done : nhận diện xong
processing --> cErr : lỗi nhận diện
cErr --> queued : [còn lượt thử]
cErr --> failed : [lần thứ 3]
queued --> expired : quá 60 s
done --> confirmed : xác nhận
done --> discarded : bỏ
@enduml
