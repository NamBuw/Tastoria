  enum SlotMon {
    man
    rau
    canh
  }
  enum MucTuoi {
    tuoi
    dung_som
    dung_ngay
    kiem_tra
  }
  enum TrangThaiLo {
    in_stock
    not_seen
    used_up
    discarded
  }
  enum LyDoGiaoDich {
    scan_add
    cook_deduct
    manual_edit
    discard
    undo
  }
  enum TrangThaiQuet {
    queued
    processing
    done
    failed
    expired
    confirmed
    discarded
  }
  enum TrangThaiMam {
    proposed
    accepted
    cooked
    abandoned
    expired
  }
  enum TrangThaiPhienNau {
    in_progress
    completed
    reverted
    abandoned
  }
  enum LyDoDoiMon {
    khong_hop_gu
    moi_an
    thieu_thoi_gian
    khac
  }
  enum Bua {
    lunch
    dinner
  }
  enum MucLuongEnum {
