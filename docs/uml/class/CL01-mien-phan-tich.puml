  }
  enum MucVanDong {
    light
    moderate
    heavy
  }
  enum MucTieu {
    maintain
    lose
    expert
  }
  enum NguonKcal {
    suggested
    user
    expert
  }
  enum HanhDongDongY {
    grant
    withdraw
  }
  enum KenhDongY {
    onboarding
    settings
  }
  enum LoaiYeuCauDSR {
    access
    export
    correct
    delete
    withdraw
    restrict
    object
  }
  enum TrangThaiDSR {
    received
    in_progress
    completed
    rejected
  }
  enum NgonNgu {
    vi
    en
  }
  enum CanCuDiUng {
    codex_2024
    tastoria_extra
  }
  enum TrangThaiMon {
    draft
    published
    retired
  }
  enum VaiTroNguyenLieu {
    main
    side
    seasoning
  }
  enum LoaiBuoc {
    active
    passive
  }
  enum LoaiThe {
    flavor
    texture
    occasion
  }
  enum DinhNghiaTheHien {
    item
    group_of
