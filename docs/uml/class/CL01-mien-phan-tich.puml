    edited
  }
  enum TrangThaiMucDiCho {
    open
    bought
    dropped
  }
  enum TrangThaiMonTrongMam {
    active
    swapped_out
  }
  enum NguonThayThe {
    lookup
    embedding
    user
  }
  enum TrangThaiPhienBanMH {
    candidate
