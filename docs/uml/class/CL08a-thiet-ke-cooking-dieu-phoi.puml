@startuml
title CL08a — Thiết kế module cooking: điều phối và dữ liệu
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor White

class "CookingRouter" as R <<router>> {
  +start()
  +complete()
  +undo()
  +abandon()
}
class "CookingService" as S <<service>> {
  +start()
  +complete()
  +undo()
  +abandon()
}
class "CookingRepository" as RP <<repository>> {
  +add_session()
  +lock_session()
  +add_entries()
  +transition()
}
class "CookSession" as CS <<domain>> {
  -meal_plan_id: UUID
  -status: SessionStatus
  -serve_at: datetime
  -burners: int
  -completed_at: datetime
}
class "ScheduleEntry" as SE <<domain>> {
  -recipe_id: UUID
  -step_no: int
  -start_offset_s: int
  -end_offset_s: int
}
class "CookCompletion" as CC <<DTO>> {
  -cook_session: CookSessionOut
  -deductions: list
  -interactions_recorded: int
}

R ..> S
S ..> RP
RP ..> CS
CS "1" *-- "1..*" SE
S ..> CC
@enduml
