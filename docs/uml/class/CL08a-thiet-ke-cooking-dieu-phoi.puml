@startuml
title CL08a — Thiết kế module cooking: điều phối và dữ liệu
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor White

class "CookingRouter" as R <<router>> {
  +start(req: CookStartRequest): CookSessionOut
  +complete(id: UUID, req: CookCompleteRequest): CookCompletion
  +undo(id: UUID): CookSessionOut
  +abandon(id: UUID): CookSessionOut
}
class "CookingService" as S <<service>> {
  +start(user_id: UUID, req: CookStartRequest): CookSessionOut
  +complete(user_id: UUID, session_id: UUID): CookCompletion
  +undo(user_id: UUID, session_id: UUID, now: datetime): CookSessionOut
  +abandon(user_id: UUID, session_id: UUID): CookSessionOut
}
class "CookingRepository" as RP <<repository>> {
  +add_session(s: CookSession): None
  +lock_session(session_id: UUID): CookSession
  +add_entries(session_id: UUID, entries: list): None
  +transition(session_id: UUID, to: SessionStatus): bool
}
class "CookSession" as CS <<domain>> {
  -meal_plan_id: UUID
  -status: SessionStatus
  -serve_at: datetime
  -burners: int
  -completed_at: datetime
}
class "ScheduleEntry" as SE <<domain>> {
  -recipe_id: UUID
  -step_no: int
  -start_offset_s: int
  -end_offset_s: int
}
class "CookCompletion" as CC <<DTO>> {
  -cook_session: CookSessionOut
  -deductions: list
  -interactions_recorded: int
}

R ..> S
S ..> RP
RP ..> CS
CS *-- "1..*" SE
S ..> CC
@enduml
