@startuml
title CL05a — Thiết kế module meal: điều phối và dữ liệu
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor White

class "MealRouter" as R <<router>> {
  +create_plan(req: MealPlanRequest): MealPlanOut
  +accept(id: UUID): MealPlanOut
  +swap(id: UUID, item_id: UUID, req: SwapRequest): MealPlanOut
  +list_substitutes(id: UUID, item_id: UUID): list
  +choose_substitution(id: UUID, item_id: UUID): ItemOut
}
class "MealService" as S <<service>> {
  +create_plan(user_id: UUID, req: MealPlanRequest): MealPlanOut
  +accept(user_id: UUID, plan_id: UUID): MealPlanOut
  +swap_item(plan_id: UUID, item_id: UUID, reason: SwapReason): MealPlanOut
  +choose_substitution(plan_id: UUID, item_id: UUID): ItemOut
  +get_plan_for_cooking(user_id: UUID, plan_id: UUID): PlanForCooking
}
class "MealRepository" as RP <<repository>> {
  +add_plan(plan: MealPlan): None
  +get_plan(user_id: UUID, plan_id: UUID): MealPlan
  +set_status(plan_id: UUID, status: PlanStatus): None
  +swap_out(item_id: UUID, new_item: MealPlanItem): None
}
class "MealPlanRequest" as RQ <<DTO>> {
  -meal: Meal
  -persons: int
  -max_minutes: int
  -pinned_lot_ids: list
}
class "MealPlan" as MP <<domain>> {
  -meal: Meal
  -persons: int
  -status: PlanStatus
  -e_target_kcal: float
}
class "MealPlanItem" as MI <<domain>> {
  -slot: Slot
  -recipe_id: UUID
  -servings_scale: float
  -status: ItemStatus
}

R ..> S
R ..> RQ
S ..> RP
RP ..> MP
MP *-- "2..3" MI
@enduml
