@startuml
title CL14b — Tầng giao diện: màn hình mâm cơm và nấu (Expo)
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor White

class "TrayScreen" as TS <<screen>> {
  -meal: Meal
  +useCreatePlan(meal: Meal): Mutation
}
class "PlanView" as PV <<screen>> {
  -plan: MealPlanOut
  +swap(): MealPlanOut
  +cook(): CookSessionOut
}
class "Missing" as MS <<screen>> {
  -item: MealPlanItemOut
  +apply(): MealPlanOut
}
class "Cooking" as CO <<screen>> {
  -session: CookSessionOut
  +abandon(): CookSessionOut
}
class "Finished" as FI <<screen>> {
  -session: CookSessionOut
  +finish(): void
  +undo(): CookSessionOut
}
class "lib/outbox" as OB <<module>> {
  +enqueueComplete(sessionId: string, body: CookCompleteRequest): void
  +flush(): void
  +getCompleteOutcome(sessionId: string): CompleteOutcome
}

TS *-- "0..1" PV
PV *-- "0..*" MS
PV ..> CO
CO ..> FI
FI ..> OB
@enduml
