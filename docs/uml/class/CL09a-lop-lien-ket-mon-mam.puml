@startuml
title CL09a — Lớp liên kết: thành phần món và món trong mâm
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor White

class "Món" as MON {
  -tên: Chuỗi
  -slot: Slot
  -khẩuPhầnGốc: Số nguyên
}
class "Nguyên liệu" as NL {
  -tên: Chuỗi
  -đếmĐược: Boolean
}
class "Thành phần món" as TPM {
  -lượng: Gam
  -vaiTrò: VaiTròNL
  -luônCó: Boolean
}
class "Mâm cơm" as MAM {
  -bữa: Bữa
  -sốNgười: Số nguyên
  -trạngThái: TrạngTháiMâm
}
class "Món trong mâm" as MTM {
  -slot: Slot
  -hệSốKhẩuPhần: Số thực
  -trạngThái: TrạngTháiMónMâm
}

MON "0..*" -- "1..*" NL : dùng
(MON, NL) .. TPM
MAM "0..*" -- "2..3" MON : gồm
(MAM, MON) .. MTM
@enduml
