@startuml
title CL07a — Thiết kế module scan: điều phối và dữ liệu
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor White

class "ScanRouter" as R <<router>> {
  +create_scan(mode: ScanMode, images: list): ScanAccepted
  +get_scan(id: UUID, wait: int): ScanOut
  +update_item(id: UUID, item_id: UUID, req: ItemPatch): ItemOut
  +confirm(id: UUID): ConfirmOut
  +discard(id: UUID): ScanOut
}
class "ScanService" as S <<service>> {
  +create_scan(user_id: UUID, mode: ScanMode, images: list): ScanAccepted
  +get_scan(user_id: UUID, scan_id: UUID, wait_s: int): ScanOut
  +confirm(user_id: UUID, scan_id: UUID): ConfirmOut
  +discard(user_id: UUID, scan_id: UUID): ScanOut
  +sweep_stuck_scans(now: datetime): int
}
class "ScanRepository" as RP <<repository>> {
  +add_scan(scan: Scan): None
  +get_scan(user_id: UUID, scan_id: UUID): Scan
  +set_status(scan_id: UUID, status: ScanStatus): None
  +upsert_item(item: ScanItem): None
  +stuck_scans(now: datetime): list
}
class "Scan" as SC <<domain>> {
  -mode: ScanMode
  -status: ScanStatus
  -attempts: int
  -enqueued_at: datetime
}
class "ScanImage" as SI <<domain>> {
  -ordinal: int
  -shelf_group: int
  -storage_key: str
  -contributed: bool
}
class "ScanItem" as IT <<domain>> {
  -ingredient_id: UUID
  -final_count: int
  -qty_level: QtyLevel
  -user_action: Action
}

R ..> S
S ..> RP
RP ..> SC
SC *-- "1..2" SI
SC *-- "0..*" IT
@enduml
