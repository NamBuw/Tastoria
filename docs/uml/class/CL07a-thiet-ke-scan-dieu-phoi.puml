@startuml
title CL07a — Thiết kế module scan: điều phối và dữ liệu
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor White

class "ScanRouter" as R <<router>> {
  +create_scan()
  +get_scan()
  +update_item()
  +confirm()
  +discard()
}
class "ScanService" as S <<service>> {
  +create_scan()
  +get_scan()
  +confirm()
  +discard()
  +sweep_stuck_scans()
}
class "ScanRepository" as RP <<repository>> {
  +add_scan()
  +get_scan()
  +set_status()
  +upsert_item()
  +stuck_scans()
}
class "Scan" as SC <<domain>> {
  -mode: ScanMode
  -status: ScanStatus
  -attempts: int
  -enqueued_at: datetime
}
class "ScanImage" as SI <<domain>> {
  -ordinal: int
  -shelf_group: int
  -storage_key: str
  -contributed: bool
}
class "ScanItem" as IT <<domain>> {
  -ingredient_id: UUID
  -final_count: int
  -qty_level: QtyLevel
  -user_action: Action
}

R ..> S
S ..> RP
RP ..> SC
SC "1" *-- "1..2" SI
SC "1" *-- "0..*" IT
@enduml
