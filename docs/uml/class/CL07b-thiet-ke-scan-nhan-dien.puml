@startuml
title CL07b — Thiết kế module scan: job nhận diện
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor White

class "InferenceJob" as J <<worker job>> {
  +warm_up()
  +run()
}
class "ImageSanitizer" as IS <<domain service>> {
  +sanitize()
}
class "DetectionMerger" as DM <<domain service>> {
  +merge()
}
class "ChipBuilder" as CB <<domain service>> {
  +build()
}
class "Detection" as DT <<domain>> {
  -box: Box
  -confidence: float
  -p_fresh: FreshnessProbs
}
class "ScanItem" as IT <<domain>> {
  -ingredient_id: UUID
  -model_count: int
}

J ..> DM
J ..> CB
DM ..> DT
CB ..> IT
J ..> IS
@enduml
