@startuml
title CL01c — Miền: nguyên liệu, dinh dưỡng và dị ứng
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor White

class "Nhóm thực phẩm" as NTP {
  -mã: Chuỗi
  -tên: Chuỗi
}
class "Nguyên liệu" as NL {
  -tên: Chuỗi
  -đếmĐược: Boolean
  -hạnDùng: Số ngày
}
class "Thực phẩm tham chiếu" as TP {
  -nguồn: Chuỗi
  -mãNguồn: Chuỗi
  -tỉLệThải: %
}
class "Chất dinh dưỡng" as CDD {
  -mã: Chuỗi
  -đơnVị: Chuỗi
}
class "Giá trị dinh dưỡng" as GT {
  -lượngTrên100g: Số thực
}
class "Nhóm dị ứng" as DU {
  -mã: Chuỗi
  -tên: Chuỗi
}

NTP "1" -- "0..*" NL : thuộc
NL "0..*" -- "0..1" TP : tra
TP "1" -- "0..*" GT
CDD "1" -- "0..*" GT
NL "0..*" -- "0..*" DU : chứa
@enduml
