@startuml
title CL05b — Thiết kế module meal: dịch vụ ghép mâm
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor White

class "MealService" as S <<service>> {
  +create_plan(user_id: UUID, req: MealPlanRequest): MealPlanOut
  +swap_item(plan_id: UUID, item_id: UUID, reason: SwapReason): MealPlanOut
}
class "HardFilter" as HF <<domain service>> {
  +filter(recipes: list, c: MealConstraints): list
}
class "TasteRanker" as TR <<domain service>> {
  +score(user_id: UUID, recipes: list): dict
}
class "TrayComposer" as TC <<domain service>> {
  +compose(cands: dict, stock: StockView): list
  +resolve_swap(plan: MealPlan, slot: Slot): TrayResult
}
class "MakespanEstimator" as ME <<domain service>> {
  +estimate(steps: list, burners: int): int
}
class "ReasonBuilder" as RB <<domain service>> {
  +build(best: TrayScore, runner_up: TrayScore): str
}

S ..> HF
S ..> TR
S ..> TC
TC ..> ME
S ..> RB
@enduml
