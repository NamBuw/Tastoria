@startuml
title CL01f — Miền: quét ảnh và nhận diện
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor White

class "Lần quét" as LQ {
  -chếĐộ: ChếĐộQuét
  -trạngThái: TrạngTháiQuét
  -sốLầnThử: Số nguyên
}
class "Ảnh quét" as AQ {
  -thứTự: Số nguyên
  -nhómNgăn: Số nguyên
  -đãGóp: Boolean
}
class "Khung phát hiện" as KH {
  -toạĐộ: Khung
  -độTinCậy: Số thực
  -xácSuấtTươi: Số thực
}
class "Chip nguyên liệu" as CHIP {
  -nguồn: NguồnChip
  -sốĐếmCuối: Số nguyên
  -mứcLượng: MứcLượng
  -thaoTác: ThaoTácChip
}
class "Lớp thị giác" as LTG {
  -mã: Chuỗi
  -cóMôHìnhTươi: Boolean
}
class "Nguyên liệu" as NL {
  -tên: Chuỗi
}

LQ "1" *-- "1..2" AQ
AQ "1" *-- "0..*" KH
KH "0..*" -- "1" LTG
KH "0..*" -- "0..1" CHIP : gộp vào
LQ "1" *-- "0..*" CHIP : đề xuất
CHIP "0..*" -- "1" NL
@enduml
