@startuml
title CL06b — Thiết kế module pantry: quy đổi lượng và độ gấp
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor White

class "PantryService" as S <<service>> {
  +deduct_for_cooking()
  +list_available_lots()
}
class "UrgencyCalculator" as UC <<domain service>> {
  +u_time()
  +u_img()
  +urgency()
}
class "QuantityConverter" as QC <<domain service>> {
  +from_count()
  +from_level()
}
class "DeductionPlanner" as DP <<domain service>> {
  +plan()
}
class "Urgency" as UR <<value object>> {
  -u: float
  -source: str
}
class "FreshnessProbs" as FP <<value object>> {
  -p_tuoi: float
  -p_dung_som: float
  -p_dung_ngay: float
  -p_kiem_tra: float
}

S ..> UC
S ..> QC
S ..> DP
UC ..> UR
UC ..> FP
@enduml
