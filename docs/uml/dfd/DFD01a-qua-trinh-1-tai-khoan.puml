@startuml
title DFD01a — Mức 1, quá trình 1.0 Quản lý tài khoản, hồ sơ và đồng ý
' Sinh từ docs/sad/tools/diagrams/model.py — sửa ở đó rồi chạy gen_puml.py, không sửa tay.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 110

left to right direction

usecase "1.0\nQuản lý tài khoản, hồ sơ và đồng ý" as P
rectangle "Người dùng" as E1
rectangle "Dịch vụ email" as E6
database "D1 Tài khoản, hồ sơ và đồng ý" as D1
database "D2 Danh mục món và nguyên liệu" as D2
database "D10 Yêu cầu dữ liệu và kiểm toán" as D10
E1 --> P : đăng ký, đăng nhập, hồ sơ, đồng ý
P --> E1 : phiên đăng nhập, hồ sơ, mục tiêu kcal
P --> E6 : thư đặt lại mật khẩu
D1 --> P : tài khoản, đồng ý hiện hành
P --> D1 : tài khoản, hồ sơ, sự kiện đồng ý
D2 --> P : nhóm dị ứng, chế độ ăn, món hay ăn
P --> D10 : yêu cầu tải, xoá, rút đồng ý
@enduml
