@startuml
title ERD01 — Lõi, định danh và quyền riêng tư (core, identity, privacy)
hide circle

entity "idempotency_keys" as idempotency_keys {
  * user_id : uuid <<PK, FK>>
  * key : text <<PK>>
  --
  * request_sha256 : bytea
  * status_code : smallint
  * response_body : jsonb
  * created_at : timestamptz
}
entity "users" as users {
  * id : uuid <<PK>>
  --
  * email : citext <<UQ>>
  * password_hash : text
  * role : user_role_t
  * status : user_status_t
  * token_version : integer
  * failed_logins : smallint
    locked_until : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
}
entity "refresh_tokens" as refresh_tokens {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * family_id : uuid
  * token_sha256 : bytea <<UQ>>
  * issued_at : timestamptz
  * expires_at : timestamptz
    revoked_at : timestamptz
    replaced_by_id : uuid <<FK, UQ>>
    user_agent : text
}
entity "password_resets" as password_resets {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * token_sha256 : bytea <<UQ>>
  * created_at : timestamptz
  * expires_at : timestamptz
    used_at : timestamptz
}
entity "consent_purposes" as consent_purposes {
  * code : text <<PK>>
  --
  * name_vi : text
  * description_vi : text
  * data_category : text
  * is_sensitive : boolean
  * is_required : boolean
}
entity "policy_versions" as policy_versions {
  * id : uuid <<PK>>
  --
  * purpose_code : text <<FK>>
  * version : text
  * text_sha256 : bytea
  * effective_from : timestamptz
  .. UNIQUE(purpose_code, version) ..
}
entity "consent_events" as consent_events {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * policy_version_id : uuid <<FK>>
  * action : consent_action_t
  * channel : consent_channel_t
    app_version : text
  * created_at : timestamptz
}
entity "dsr_requests" as dsr_requests {
  * id : uuid <<PK>>
  --
    user_id : uuid <<FK>>
  * subject_ref : bytea
  * type : dsr_type_t
  * status : dsr_status_t
  * received_at : timestamptz
    acknowledged_at : timestamptz
    completed_at : timestamptz
    result_key : text
    note : text
}
entity "audit_log" as audit_log {
  * id : bigint <<PK>>
  --
    actor_user_id : uuid <<FK>>
  * actor_role : text
  * action : text
  * entity : text
    entity_id : text
    purpose : text
    request_id : text
  * created_at : timestamptz
}

users ||--o{ idempotency_keys : user_id (cascade)
users ||--o{ refresh_tokens : user_id (cascade)
refresh_tokens |o--o| refresh_tokens : replaced_by_id
users ||--o{ password_resets : user_id (cascade)
consent_purposes ||--o{ policy_versions : purpose_code
users ||--o{ consent_events : user_id (cascade)
policy_versions ||--o{ consent_events : policy_version_id
users |o--o{ dsr_requests : user_id (set_null)
users |o--o{ audit_log : actor_user_id (set_null)

legend right
  * = NOT NULL; PK khoá chính; FK khoá ngoại; UQ duy nhất
  UNIQUE(...) WHERE ...: chỉ mục duy nhất một phần (không phải khoá của cả bảng)
  ||  đúng một; |o  không hoặc một
  o{  không hoặc nhiều; o|  không hoặc một
  (cascade), (set_null): hành vi ON DELETE; không ghi = NO ACTION
  Thực thể nền xám: bảng thuộc sơ đồ khác (chỉ ghi khoá chính)
endlegend

@enduml
