@startuml
title ERD08 — Tổng quan bảng theo module (chỉ tên bảng; cột ở ERD01a–ERD07b)
' Sinh từ db/schema.sql — không sửa tay.
hide circle
hide empty members
skinparam defaultFontName DejaVu Sans
skinparam linetype ortho
skinparam packageStyle rectangle
left to right direction

package "ERD01a Định danh và khoá lũy đẳng (core, identity)" {
  entity "users" as users
  entity "refresh_tokens" as refresh_tokens
  entity "password_resets" as password_resets
  entity "idempotency_keys" as idempotency_keys
}
package "ERD01b Đồng ý, yêu cầu dữ liệu và kiểm toán (privacy)" {
  entity "consent_purposes" as consent_purposes
  entity "policy_versions" as policy_versions
  entity "consent_events" as consent_events
  entity "dsr_requests" as dsr_requests
  entity "audit_log" as audit_log
}
package "ERD02 Hồ sơ người dùng (profile)" {
  entity "profiles" as profiles
  entity "user_allergens" as user_allergens
  entity "user_favorite_recipes" as user_favorite_recipes
  entity "user_settings" as user_settings
}
package "ERD03a Danh mục: thành phần thực phẩm và dinh dưỡng" {
  entity "food_groups" as food_groups
  entity "nutrient_sources" as nutrient_sources
  entity "food_items" as food_items
  entity "nutrients" as nutrients
  entity "food_nutrients" as food_nutrients
}
package "ERD03b Danh mục: nguyên liệu, dị ứng và chế độ ăn" {
  entity "ingredients" as ingredients
  entity "ingredient_synonyms" as ingredient_synonyms
  entity "ingredient_allergens" as ingredient_allergens
  entity "allergen_groups" as allergen_groups
  entity "diets" as diets
  entity "diet_exclusions" as diet_exclusions
}
package "ERD03c Danh mục: đơn vị, mức lượng và lớp thị giác" {
  entity "ingredient_units" as ingredient_units
  entity "qty_levels" as qty_levels
  entity "vision_classes" as vision_classes
  entity "vision_class_ingredients" as vision_class_ingredients
}
package "ERD04a Món ăn: công thức và bước nấu" {
  entity "recipes" as recipes
  entity "recipe_ingredients" as recipe_ingredients
  entity "recipe_steps" as recipe_steps
  entity "cooking_methods" as cooking_methods
  entity "recipe_make_ahead" as recipe_make_ahead
}
package "ERD04b Món ăn: thẻ, nguồn và dinh dưỡng món" {
  entity "tags" as tags
  entity "recipe_tags" as recipe_tags
  entity "recipe_sources" as recipe_sources
  entity "recipe_nutrition" as recipe_nutrition
}
package "ERD05a Kho nguyên liệu (pantry)" {
  entity "pantry_lots" as pantry_lots
  entity "pantry_transactions" as pantry_transactions
}
package "ERD05b Quét ảnh (scan)" {
  entity "scans" as scans
  entity "scan_images" as scan_images
  entity "scan_items" as scan_items
  entity "detections" as detections
}
package "ERD06a Mâm cơm và món trong mâm (meal)" {
  entity "meal_plans" as meal_plans
  entity "meal_plan_items" as meal_plan_items
  entity "meal_plan_item_substitutions" as meal_plan_item_substitutions
}
package "ERD06b Ràng buộc mâm: dị ứng người ăn cùng, lô ghim (meal)" {
  entity "meal_plan_coeater_allergens" as meal_plan_coeater_allergens
  entity "meal_plan_pins" as meal_plan_pins
}
package "ERD06c Thay thế và đi chợ (substitute)" {
  entity "substitution_pairs" as substitution_pairs
  entity "ingredient_embeddings" as ingredient_embeddings
  entity "shopping_items" as shopping_items
}
package "ERD06d Phiên nấu và lịch nấu (cooking)" {
  entity "cook_sessions" as cook_sessions
  entity "cook_schedule_entries" as cook_schedule_entries
}
package "ERD06e Tương tác (events)" {
  entity "interactions" as interactions
}
package "ERD07a Vận hành mô hình (mlops)" {
  entity "model_versions" as model_versions
  entity "model_version_classes" as model_version_classes
  entity "model_deployments" as model_deployments
}
package "ERD07b Khảo sát gu (survey)" {
  entity "survey_forms" as survey_forms
  entity "survey_form_anchors" as survey_form_anchors
  entity "survey_respondents" as survey_respondents
  entity "survey_assignments" as survey_assignments
  entity "survey_ratings" as survey_ratings
  entity "survey_favorites" as survey_favorites
}
