# GENERATED by backend/scripts/gen_importlinter.py from docs/sad/model.yaml — do not edit by hand.
# Run: uv run --package tastoria-backend lint-imports --config backend/.importlinter
# Modules with code: core, identity, privacy, catalog, profile, jobs

[importlinter]
root_package = tastoria
include_external_packages = False

[importlinter:contract:M01-core-deps]
name = M01 core may import only no other module (model.yaml)
type = forbidden
source_modules = tastoria.core
forbidden_modules =
    tastoria.modules.identity
    tastoria.modules.privacy
    tastoria.modules.catalog
    tastoria.modules.profile
    tastoria.jobs
    tastoria.app
    tastoria.cli
    tastoria.models_registry
    tastoria.migrations
allow_indirect_imports = True

[importlinter:contract:M01-core-private]
name = M01 core: internals are private (models)
type = protected
protected_modules =
    tastoria.core.models
allowed_importers =
    tastoria.core
    tastoria.app
    tastoria.cli
    tastoria.models_registry

